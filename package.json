{
  "name": "hyperoffice",
  "private": true,
  "description": "HyperOffice productivity suite monorepo",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "node -e \"console.error('No e2e suites exist yet (no UI vertical slice). See docs/architecture/gap-analysis.md.'); process.exit(1)\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.apps.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "rea": "npx --yes rea-agents@6.9.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "prettier": "3.10.1",
    "turbo": "2.11.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
