{
  "name": "@hyperoffice/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "HyperOffice desktop preview: HyperDoc, HyperSheet, HyperDeck, HyperPlan, and the suite launcher.",
  "author": "HyperOffice",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "node scripts/build.ts && electron .",
    "smoke": "node scripts/build.ts && node scripts/smoke.ts",
    "package": "node scripts/build.ts && node scripts/package.ts",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@hyperoffice/format-detector": "workspace:*",
    "@hyperoffice/office-formats": "workspace:*"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "hyperoffice": {
    "status": "preview",
    "owner": "@hyperoffice/apps"
  }
}
