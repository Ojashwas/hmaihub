{
  "format": "docm",
  "product": "hyperdoc",
  "extensions": [".docm"],
  "mediaType": "application/vnd.ms-word.document.macroEnabled.12",
  "capabilities": {
    "detect": {
      "supported": true,
      "level": "L0",
      "notes": "Detected and flagged MACROS_PRESENT. Macros are never executed."
    },
    "open": { "supported": true, "level": "L2", "notes": "Opened with a warning; macros are not loaded or executed." },
    "inspect": { "supported": true, "level": "L1" },
    "edit": { "supported": true, "level": "L3" },
    "save": {
      "supported": false,
      "notes": "Never overwritten; saving always produces a macro-free .docx via Save As."
    },
    "saveAs": { "supported": false },
    "templates": { "supported": false }
  },
  "roundTripLevel": "none",
  "macroPreservation": "unsupported",
  "encryptionSupport": "unsupported",
  "digitalSignaturePreservation": "unsupported",
  "knownLosses": ["VBA macros are dropped when saving as .docx (the user is warned)", "All losses listed for DOCX"],
  "testCoverage": ["tools/format-detector/tests/detect.test.ts", "packages/office-formats/tests/formats.test.ts"],
  "reaInvestigations": [],
  "status": "experimental"
}
