{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hyperoffice.example/licensing/public-key-set.schema.json",
  "title": "HyperOffice licence public key set",
  "description": "Published at /.well-known/hyperoffice-license-keys.json and embedded in client builds. Private members (d, p, q, dp, dq, qi) are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["keys"],
  "properties": {
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kty", "crv", "x", "kid", "alg", "use", "status", "environment"],
        "properties": {
          "kty": { "enum": ["OKP", "EC"] },
          "crv": { "enum": ["Ed25519", "P-256"] },
          "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
          "y": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
          "kid": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
          "alg": { "enum": ["EdDSA", "ES256"] },
          "use": { "const": "sig" },
          "status": { "enum": ["next", "active", "retired", "compromised"] },
          "environment": { "enum": ["production", "staging", "development", "test"] }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "alg": { "const": "EdDSA" } } },
            "then": { "properties": { "kty": { "const": "OKP" }, "crv": { "const": "Ed25519" } } }
          },
          {
            "if": { "properties": { "alg": { "const": "ES256" } } },
            "then": {
              "properties": { "kty": { "const": "EC" }, "crv": { "const": "P-256" }, "y": { "type": "string" } },
              "required": ["y"]
            }
          }
        ]
      }
    }
  }
}
